SOURCE_DIR=./example-project/src
OUTPUT_DIR=./output
REPORTS_DIR=./reports
LOGS_DIR=./logs
SKIP_DIRS=

# Optional AI enhancement. Set the provider's key and an explicit model.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
AI_PROMPT_FILE=
AI_MAX_TOKENS=8192
AI_MAX_FILE_LINES=1000
AI_MAX_RETRIES=3
AI_REQUEST_DELAY_MS=250
AI_RATE_LIMIT_WAIT_S=30
CONCURRENCY=2

TS_STRICT=true
TS_TARGET=ES2022
TS_MODULE=ESNext
DRY_RUN=false
SKIP_AI=false
LOG_LEVEL=info
